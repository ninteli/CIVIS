# Token du bot Discord (obligatoire)
# Cree une application sur https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# URL du serveur LLM local (routeur llama-server compatible OpenAI)
LLM_URL=http://127.0.0.1:8080

# Modeles locaux utilises par defaut (doivent correspondre aux sections de models-preset.ini)
LLM_CHAT_MODEL=gemma3:1B
LLM_AGENT_MODEL=qwen2.5:3B

# Duree de conservation en RAM avant mise en veille (info/config)
LLM_KEEP_ALIVE=15m

# (Optionnel) Secret de chiffrement AES-256-GCM pour les cles API (/apikey) et webhooks (/logs)
# Recommande en production / Docker / systemd. Sinon une cle maitre est generee dans ~/.config/civis/master.key
# KEY_ENCRYPTION_SECRET=change_me_with_a_long_random_secret

# (Optionnel) Chemin personnalise pour le fichier cle maitre
# CIVIS_MASTER_KEY_FILE=/path/to/master.key

# (Optionnel) Personnaliser le prompt systeme du bot (remplace le persona Civis par defaut)
# SYSTEM_PROMPT="Tu es un assistant d'administration Discord utile et concis."
